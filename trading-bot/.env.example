# Copy this file to .env and fill in your real Alpaca API keys.
# Get keys from https://app.alpaca.markets/ (use the PAPER keys, not live, until you're ready).
# NEVER commit your real .env file — it's already in .gitignore.

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# true = paper trading (fake money, real market data). Only set to false when you are
# deliberately ready to trade with real money.
ALPACA_PAPER=true
